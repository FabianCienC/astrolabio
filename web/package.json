{
  "name": "astrolabio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:contract": "json2ts -i ../contract/galaxy.schema.json -o src/contract/galaxy.ts --no-additionalProperties --bannerComment \"/* Generated from contract/galaxy.schema.json by npm run gen:contract. Do not edit. */\""
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "lil-gui": "0.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
