{
  "$defs": {
    "ArgoStatus": {
      "additionalProperties": false,
      "description": "Sync and health of the Argo CD `Application`.\n\nNo `revision`: it is a commit of the private GitOps repo.",
      "properties": {
        "sync": {
          "enum": [
            "Synced",
            "OutOfSync",
            "Unknown"
          ],
          "type": "string"
        },
        "health": {
          "enum": [
            "Healthy",
            "Progressing",
            "Degraded",
            "Suspended",
            "Missing",
            "Unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "sync",
        "health"
      ],
      "title": "ArgoStatus",
      "type": "object"
    },
    "Commit": {
      "additionalProperties": false,
      "description": "Deployed commit, taken from the image tag (the SHA set by CI).",
      "properties": {
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "sha",
        "url"
      ],
      "title": "Commit",
      "type": "object"
    },
    "Constellation": {
      "additionalProperties": false,
      "description": "A namespace labeled `fabiancienfuegos.com/astrolabio: visible`.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "project": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "argo": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArgoStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "workloads": {
          "items": {
            "$ref": "#/$defs/Workload"
          },
          "type": "array"
        },
        "services": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        },
        "routes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Route"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "project",
        "description",
        "repo",
        "argo",
        "health",
        "workloads",
        "services",
        "routes"
      ],
      "title": "Constellation",
      "type": "object"
    },
    "Core": {
      "additionalProperties": false,
      "description": "The galactic core: platform components and the cluster nodes.",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/InfraComponent"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        }
      },
      "required": [
        "components",
        "nodes"
      ],
      "title": "Core",
      "type": "object"
    },
    "InfraComponent": {
      "additionalProperties": false,
      "description": "Platform component published from the API's closed catalog.\n\nIts pods and services are drawn, but anonymously: no names, versions, image\ntags, IPs or configuration.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "purpose": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "category": {
          "enum": [
            "control",
            "network",
            "ingress",
            "gitops",
            "security"
          ],
          "type": "string"
        },
        "system": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "replicas": {
          "$ref": "#/$defs/Replicas"
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "argo": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArgoStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "$ref": "#/$defs/Metrics",
          "default": {
            "cpu_millicores": null,
            "memory_mib": null
          }
        },
        "pods": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Pod"
          },
          "type": "array"
        },
        "services": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "category",
        "system",
        "replicas",
        "health",
        "argo",
        "metrics",
        "pods",
        "services"
      ],
      "title": "InfraComponent",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "description": "CPU and memory (phase 3, metrics-server). `None` until there is data.",
      "properties": {
        "cpu_millicores": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cpu_millicores",
        "memory_mib"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "Cluster node, published under a generic name (no hostname or IP).",
      "properties": {
        "id": {
          "enum": [
            "control-plane",
            "worker-1",
            "worker-2"
          ],
          "type": "string"
        },
        "name": {
          "enum": [
            "control plane",
            "worker 1",
            "worker 2"
          ],
          "type": "string"
        },
        "role": {
          "enum": [
            "control-plane",
            "worker"
          ],
          "type": "string"
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "pods": {
          "minimum": 0,
          "type": "integer"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics",
          "default": {
            "cpu_millicores": null,
            "memory_mib": null
          }
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "health",
        "pods",
        "metrics"
      ],
      "title": "Node",
      "type": "object"
    },
    "Pod": {
      "additionalProperties": false,
      "description": "A pod. `name` is `None` for platform pods, which are published anonymously.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "Pending",
            "Running",
            "Succeeded",
            "Failed",
            "Unknown"
          ],
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "restarts": {
          "minimum": 0,
          "type": "integer"
        },
        "node": {
          "anyOf": [
            {
              "enum": [
                "control-plane",
                "worker-1",
                "worker-2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics",
          "default": {
            "cpu_millicores": null,
            "memory_mib": null
          }
        }
      },
      "required": [
        "id",
        "name",
        "phase",
        "ready",
        "restarts",
        "node",
        "health",
        "metrics"
      ],
      "title": "Pod",
      "type": "object"
    },
    "ReplicaSet": {
      "additionalProperties": false,
      "description": "The active replica set of a Deployment (two during a rollout). Old empty ones are not\npublished.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "name": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "replicas": {
          "$ref": "#/$defs/Replicas"
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "pods": {
          "items": {
            "$ref": "#/$defs/Pod"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "replicas",
        "health",
        "pods"
      ],
      "title": "ReplicaSet",
      "type": "object"
    },
    "Replicas": {
      "additionalProperties": false,
      "properties": {
        "desired": {
          "minimum": 0,
          "type": "integer"
        },
        "ready": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "desired",
        "ready"
      ],
      "title": "Replicas",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "An `HTTPRoute`: the public entry into a project. Hostnames are public by nature.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "name": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "hostnames": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "services": {
          "items": {
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "hostnames",
        "health",
        "services"
      ],
      "title": "Route",
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "description": "A Service. `targets` are the ids of the pods it selects. No ports or cluster IP.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "targets": {
          "items": {
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "health",
        "targets"
      ],
      "title": "Service",
      "type": "object"
    },
    "Workload": {
      "additionalProperties": false,
      "description": "A Deployment, StatefulSet or DaemonSet of a visible project.\n\nDeployments own pods through `replica_sets`; StatefulSets and DaemonSets own\nthem directly in `pods`.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "name": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "Deployment",
            "StatefulSet",
            "DaemonSet"
          ],
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "frontend",
                "api",
                "worker",
                "data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "criticality": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replicas": {
          "$ref": "#/$defs/Replicas"
        },
        "health": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Commit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "$ref": "#/$defs/Metrics",
          "default": {
            "cpu_millicores": null,
            "memory_mib": null
          }
        },
        "replica_sets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReplicaSet"
          },
          "type": "array"
        },
        "pods": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Pod"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "role",
        "criticality",
        "replicas",
        "health",
        "commit",
        "metrics",
        "replica_sets",
        "pods"
      ],
      "title": "Workload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2,
      "default": 2,
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "constellations": {
      "items": {
        "$ref": "#/$defs/Constellation"
      },
      "type": "array"
    },
    "core": {
      "$ref": "#/$defs/Core"
    }
  },
  "required": [
    "version",
    "generated_at",
    "constellations",
    "core"
  ],
  "title": "Galaxy",
  "type": "object"
}
