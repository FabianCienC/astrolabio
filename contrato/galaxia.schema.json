{
  "$defs": {
    "Commit": {
      "additionalProperties": false,
      "description": "Commit desplegado, deducido del tag de la imagen (el SHA que pone el CI).",
      "properties": {
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "url"
      ],
      "title": "Commit",
      "type": "object"
    },
    "ComponenteInfra": {
      "additionalProperties": false,
      "description": "Componente de plataforma publicado desde el catálogo cerrado de la API.\n\nSin versión, tag de imagen, nombres de pods, IPs ni configuración.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "nombre": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nombre",
          "type": "string"
        },
        "funcion": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Funcion",
          "type": "string"
        },
        "categoria": {
          "enum": [
            "control",
            "red",
            "ingreso",
            "gitops",
            "seguridad"
          ],
          "title": "Categoria",
          "type": "string"
        },
        "replicas": {
          "$ref": "#/$defs/Replicas"
        },
        "salud": {
          "enum": [
            "ok",
            "degradado",
            "caido",
            "desconocido"
          ],
          "title": "Salud",
          "type": "string"
        },
        "argo": {
          "anyOf": [
            {
              "$ref": "#/$defs/EstadoArgo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metricas": {
          "$ref": "#/$defs/Metricas",
          "default": {
            "cpu_milicores": null,
            "memoria_mib": null
          }
        }
      },
      "required": [
        "id",
        "nombre",
        "funcion",
        "categoria",
        "replicas",
        "salud"
      ],
      "title": "ComponenteInfra",
      "type": "object"
    },
    "Constelacion": {
      "additionalProperties": false,
      "description": "Un namespace con la etiqueta `fabiancienfuegos.com/astrolabio: visible`.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "proyecto": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Proyecto",
          "type": "string"
        },
        "descripcion": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Descripcion"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo"
        },
        "argo": {
          "anyOf": [
            {
              "$ref": "#/$defs/EstadoArgo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estrellas": {
          "items": {
            "$ref": "#/$defs/Estrella"
          },
          "title": "Estrellas",
          "type": "array"
        }
      },
      "required": [
        "id",
        "proyecto",
        "estrellas"
      ],
      "title": "Constelacion",
      "type": "object"
    },
    "EstadoArgo": {
      "additionalProperties": false,
      "description": "Sync y salud del `Application`. Sin `revision`: es un commit del repo privado.",
      "properties": {
        "sync": {
          "enum": [
            "Synced",
            "OutOfSync",
            "Unknown"
          ],
          "title": "Sync",
          "type": "string"
        },
        "salud": {
          "enum": [
            "Healthy",
            "Progressing",
            "Degraded",
            "Suspended",
            "Missing",
            "Unknown"
          ],
          "title": "Salud",
          "type": "string"
        }
      },
      "required": [
        "sync",
        "salud"
      ],
      "title": "EstadoArgo",
      "type": "object"
    },
    "Estrella": {
      "additionalProperties": false,
      "description": "Un workload de un proyecto visible.",
      "properties": {
        "id": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "nombre": {
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9./-]*[a-z0-9])?$",
          "title": "Nombre",
          "type": "string"
        },
        "tipo": {
          "enum": [
            "Deployment",
            "StatefulSet",
            "DaemonSet"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "descripcion": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Descripcion"
        },
        "rol": {
          "anyOf": [
            {
              "enum": [
                "frontend",
                "api",
                "worker",
                "datos"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rol"
        },
        "criticidad": {
          "anyOf": [
            {
              "enum": [
                "alta",
                "media",
                "baja"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criticidad"
        },
        "replicas": {
          "$ref": "#/$defs/Replicas"
        },
        "salud": {
          "enum": [
            "ok",
            "degradado",
            "caido",
            "desconocido"
          ],
          "title": "Salud",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Commit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metricas": {
          "$ref": "#/$defs/Metricas",
          "default": {
            "cpu_milicores": null,
            "memoria_mib": null
          }
        }
      },
      "required": [
        "id",
        "nombre",
        "tipo",
        "replicas",
        "salud"
      ],
      "title": "Estrella",
      "type": "object"
    },
    "Metricas": {
      "additionalProperties": false,
      "description": "CPU y memoria (fase 3, metrics-server). `None` mientras no haya datos.",
      "properties": {
        "cpu_milicores": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Milicores"
        },
        "memoria_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memoria Mib"
        }
      },
      "title": "Metricas",
      "type": "object"
    },
    "Nodo": {
      "additionalProperties": false,
      "description": "Nodo del clúster, publicado con un nombre genérico (sin hostname ni IP).",
      "properties": {
        "id": {
          "enum": [
            "control-plane",
            "worker-1",
            "worker-2"
          ],
          "title": "Id",
          "type": "string"
        },
        "nombre": {
          "enum": [
            "control plane",
            "worker 1",
            "worker 2"
          ],
          "title": "Nombre",
          "type": "string"
        },
        "rol": {
          "enum": [
            "control-plane",
            "worker"
          ],
          "title": "Rol",
          "type": "string"
        },
        "salud": {
          "enum": [
            "ok",
            "degradado",
            "caido",
            "desconocido"
          ],
          "title": "Salud",
          "type": "string"
        },
        "pods": {
          "minimum": 0,
          "title": "Pods",
          "type": "integer"
        },
        "metricas": {
          "$ref": "#/$defs/Metricas",
          "default": {
            "cpu_milicores": null,
            "memoria_mib": null
          }
        }
      },
      "required": [
        "id",
        "nombre",
        "rol",
        "salud",
        "pods"
      ],
      "title": "Nodo",
      "type": "object"
    },
    "Nucleo": {
      "additionalProperties": false,
      "properties": {
        "componentes": {
          "items": {
            "$ref": "#/$defs/ComponenteInfra"
          },
          "title": "Componentes",
          "type": "array"
        },
        "nodos": {
          "items": {
            "$ref": "#/$defs/Nodo"
          },
          "title": "Nodos",
          "type": "array"
        }
      },
      "required": [
        "componentes",
        "nodos"
      ],
      "title": "Nucleo",
      "type": "object"
    },
    "Replicas": {
      "additionalProperties": false,
      "properties": {
        "deseadas": {
          "minimum": 0,
          "title": "Deseadas",
          "type": "integer"
        },
        "listas": {
          "minimum": 0,
          "title": "Listas",
          "type": "integer"
        }
      },
      "required": [
        "deseadas",
        "listas"
      ],
      "title": "Replicas",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "generada": {
      "format": "date-time",
      "title": "Generada",
      "type": "string"
    },
    "constelaciones": {
      "items": {
        "$ref": "#/$defs/Constelacion"
      },
      "title": "Constelaciones",
      "type": "array"
    },
    "nucleo": {
      "$ref": "#/$defs/Nucleo"
    }
  },
  "required": [
    "generada",
    "constelaciones",
    "nucleo"
  ],
  "title": "Galaxia",
  "type": "object"
}
